---
import { Picture } from 'astro-imagetools/components'

export interface Props {
  image: string
}

const { image } = Astro.props
---

<div
  class="common-picture overflow-hidden border border-[color:var(--line)] rounded-lg"
  style={{
    aspectRatio: '2.0'
  }}
>
  <Picture
    layout="fill"
    preload="webp"
    src={image}
    alt="Image"
    width={720 * 2}
    objectFit="cover"
  />
</div>
