---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Body from '../components/Body.astro'
import Main from '../components/Main.astro'
import Content from '../components/Content.astro'
import { getReadingTime } from '../libs/readingTime'
import dayjs from 'dayjs'
import CommonPicture from '../components/CommonPicture.astro'
import ViewedCount from '../components/ViewedCount'
import { Comments } from '../components/Comments'
import { Button, Input, Select, Space } from 'antd'
import Subscribe from '../components/Subscribe'

export interface Props {
  content: {
    title: string
    description: string
    pubDate?: string
    updatedDate?: string
    heroImage?: string
  }
}

const {
  content: { title, description, pubDate, updatedDate, heroImage }
} = Astro.props

const readingTime =
  typeof Astro.props.compiledContent === 'function'
    ? getReadingTime(Astro.props.compiledContent())
    : Astro.props.content.readingTime

// 长文目录：只取二级标题，少于 3 个不显示
const headings: { depth: number; slug: string; text: string }[] =
  Astro.props.headings ?? []
const tocHeadings = headings.filter(h => h.depth === 2)
---

<html lang="zh" style="min-height: 100vh;">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <Body>
    <Header />
    <Main>
      <Content>
        {heroImage && <CommonPicture image={heroImage} />}
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          {pubDate && <time datetime={pubDate}>{dayjs(pubDate).format('YYYY-MM-DD')}</time>}
          {updatedDate && <time datetime={updatedDate}>更新于 {dayjs(updatedDate).format('YYYY-MM-DD')}</time>}
          {readingTime && <span>约 {readingTime} 分钟</span>}
          <ViewedCount postId={title} client:load />
        </div>
        {
          tocHeadings.length >= 3 && (
            <details class="toc">
              <summary>目录</summary>
              <ol>
                {tocHeadings.map(h => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
        <hr class="border-t border-[color:var(--line)] mt-5 mb-6" />
        <slot />
      </Content>
      <Comments client:visible />
    </Main>
    <div class="p-4 text-center">
      <Subscribe client:load />
      <a
        target="_blank"
        class="text-zinc-500 underline underline-offset-2 hover:text-orange-500 decoration-orange-300"
        href="https://github.com/PeterChen1997/Astro-Home/issues/6"
        >如有发现问题，请点击这里勘误🐶</a
      >
    </div>
    <Footer />
  </Body>
</html>
