---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Body from '../components/Body.astro'
import Footer from '../components/Footer.astro'
import Main from '../components/Main.astro'
import PageHeader from '../components/PageHeader.astro'
import PostListItem from '../components/PostListItem.astro'
import dayjs from 'dayjs'

// 推荐博客：转载 / 翻译的他人文章，独立于「文章」列表和 RSS
const posts = (await Astro.glob('./recommends/*.{md,mdx}')).sort(
  (a, b) =>
    new Date(b.frontmatter.pubDate).valueOf() -
    new Date(a.frontmatter.pubDate).valueOf()
)
---

<!DOCTYPE html>
<html lang="zh" style="overflow: overlay;min-height: 100vh;">
  <head>
    <BaseHead title="推荐博客 - 龙场茶室" description="值得一读的他人文章（翻译 / 转载）" />
  </head>
  <Body>
    <Header />
    <Main>
      <PageHeader title="推荐博客" description="值得一读的他人文章，翻译分享，版权归原作者" />

      <div class="border-t border-[color:var(--line)]">
        {
          posts.map(post => (
            <PostListItem
              url={post.url}
              title={post.frontmatter.title}
              description={post.frontmatter.description}
              heroImage={post.frontmatter.heroImage}
              meta={[
                post.frontmatter.author,
                `原文 ${dayjs(post.frontmatter.pubDate).format('YYYY-MM-DD')}`
              ]}
            />
          ))
        }
      </div>
    </Main>
    <Footer />
  </Body>
</html>
