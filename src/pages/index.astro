---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../config'
import Body from '../components/Body.astro'
import Main from '../components/Main.astro'
import PageHeader from '../components/PageHeader.astro'
import PostListItem from '../components/PostListItem.astro'
import { readingTimeLabel } from '../libs/readingTime'
import dayjs from 'dayjs'
import { IoArrowForward } from 'react-icons/io5/index.js'

const posts = (await Astro.glob('./posts/*.{md,mdx}'))
  .sort(
    (a: any, b: any) =>
      new Date(b.frontmatter.pubDate).valueOf() -
      new Date(a.frontmatter.pubDate).valueOf()
  )
  .slice(0, 6)
---

<!DOCTYPE html>
<html lang="zh" style="overflow: overlay;min-height: 100vh;">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <Body>
    <Header />
    <Main>
      <PageHeader title="龙场茶室" description={SITE_DESCRIPTION} />
      <a
        class="-mt-3 inline-flex items-center gap-1 text-[15px] underline underline-offset-4 decoration-orange-500 decoration-1"
        href={'/about'}
      >
        关于我
        <IoArrowForward className="w-4 h-4" />
      </a>

      <section class="mt-10 mb-12">
        <div class="flex items-baseline justify-between pb-3 border-b border-[color:var(--line)] text-sm text-[color:var(--muted)]">
          <h2 class="text-base font-semibold text-[color:var(--ink)]">最新文章</h2>
          <span>最近 {posts.length} 篇</span>
        </div>

        <div>
          {
            posts.map((post: any) => (
              <PostListItem
                url={post.url}
                title={post.frontmatter.title}
                description={post.frontmatter.description}
                heroImage={post.frontmatter.heroImage}
                tags={post.frontmatter.tags}
                meta={[
                  dayjs(post.frontmatter.pubDate).format('YYYY-MM-DD'),
                  readingTimeLabel(post.compiledContent?.())
                ]}
              />
            ))
          }
        </div>

        <div class="mt-6">
          <a
            class="inline-flex items-center gap-1 text-[15px] underline underline-offset-4 decoration-orange-500 decoration-1"
            href={'/posts'}
          >
            查看所有文章
            <IoArrowForward className="w-4 h-4" />
          </a>
        </div>
      </section>
    </Main>
    <Footer />
  </Body>
</html>
